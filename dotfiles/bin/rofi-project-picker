#!/usr/bin/env bash
set -eu

terminal="kitty"

# Pick repo
configs="$({ echo ~/nixfiles; fd . ~/src --min-depth 1 --max-depth 1 --type d ; } | xargs -n1 basename)"
[ -n "$configs" ] || exit 0
choice="$(printf '%s\n' "$configs" | rofi -dmenu -p 'Projects:')"
[ -n "$choice" ] || exit 0

if [ "$choice" == "nixfiles" ]; then
    dir="$HOME/$choice"
else
    dir="$HOME/src/$choice"
fi

# Drop the caller's direnv env (e.g. a devShell PATH): tmux gives a new
# session the client's PATH, and direnv can't unload it there.
if [ -n "${DIRENV_DIR-}" ]; then
    eval "$(cd / && direnv export bash 2>/dev/null)"
fi

# Nuke any existing terminal instance
pkill $terminal 2>/dev/null || true
sleep 0.1

session_name=${choice//./_}
exec $terminal -e tmux new-session -As "$session_name" -c "$dir"
