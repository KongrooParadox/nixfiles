#!/usr/bin/env bash

terminal="kitty"


if [[ ${1-} == --wait-ssh ]]; then
    host=$2

    ssh_config=$(ssh -G "$host" 2>/dev/null) || exit 1
    connect_host=$(awk '$1 == "hostname" { print $2; exit }' <<< "$ssh_config")
    port=$(awk '$1 == "port" { print $2; exit }' <<< "$ssh_config")

    if [[ -z $connect_host || ! $port =~ ^[0-9]+$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
        printf 'Could not resolve SSH host and port for %s\n' "$host" >&2
        exit 1
    fi

    until nc -z -w 2 "$connect_host" "$port"; do
        sleep 2
    done

    exec ssh -t "$host" 'tmux -f /dev/null new-session -A -s ssh'
fi

hosts=$(cat ~/.ssh/known_hosts | awk '{print $1}' | grep -v -e '.com' -e '.shop' | sort | uniq)
chosenFQDN=$(echo "$hosts" | rofi -dmenu -p 'Choose host to SSH into :')
hostName=$(echo "$chosenFQDN" | perl -pe 's|\.|_|g' )
echo "$hostName"
[ -n "$hostName" ] || exit 0

# Drop the caller's direnv env (e.g. a devShell PATH): tmux gives a new
# session the client's PATH, and direnv can't unload it there.
if [ -n "${DIRENV_DIR-}" ]; then
    eval "$(cd / && direnv export bash 2>/dev/null)"
fi

session="ssh_$hostName"

if ! tmux has-session -t "$session" 2>/dev/null; then
    printf -v pane_command 'exec %q --wait-ssh %q' "$0" "$chosenFQDN"
    tmux new-session -d -s "$session" "$pane_command"
fi

if [ "${TMUX-}" ]; then
    exec tmux switch-client -t "ssh_${hostName}"
fi

client_tty="$(
  tmux list-clients -F '#{client_tty} #{client_termname}' 2>/dev/null \
  | awk "\$2 ~ /^${terminal}/ { print \$1; exit }" || true
)"

if [ -n "${client_tty}" ]; then
  # switch that client to the chosen session
  tmux switch-client -c "${client_tty}" -t "ssh_${hostName}"
  exit 0
fi

# Nuke any existing terminal instance
pkill $terminal 2>/dev/null || true
sleep 0.1

exec "$terminal" -e tmux attach -t "ssh_${hostName}"
