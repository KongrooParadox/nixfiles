{
  inputs,
  lib,
  pkgs,
  ...
}:
{
  nixpkgs = {
    hostPlatform = lib.mkDefault "x86_64-linux";
    overlays = [
      (self: super: {
        btop = super.btop.override { rocmSupport = true; };
      })
    ];
  };

  boot = {
    kernelPackages = pkgs.linuxPackages_7_2;
    kernelParams = [ "amdgpu.virtual_display=0000:01:00.0,1" ];
  };

  environment.systemPackages = [
    pkgs.rocmPackages.rocm-smi
  ];

  imports = [
    inputs.bc-250.nixosModules.bc250
    inputs.jovian.nixosModules.default
    ./steam-streaming.nix
  ];

  hardware = {
    bc250 = {
      enable = true;

      features = {
        sensors.enable = true;
        gpuGovernor.enable = true;
        zswap.enable = true;

        # Disabled by default
        aic8800d80.enable = false;
        cuLiveManager.enable = false;
        cpuOverclock.enable = false;
        # cpuOverclock.configFile = <path to config file generated by bc250-detect>;

        # Modded BIOSes may already provide their own ACPI fixes, so to avoid
        # conflicts, check first and either turn those off in the BIOS setup
        # or leave this disabled.
        acpiFix.enable = true;

        # Make sure to stress test the unlocked cores before relying
        # on them. Triggers a reboot on cold boot to apply the change.
        # See "GPU governor with core unlock" below when enabling this.
        coreUnlock.enable = true;

        # Null by default. Values are in MB.
        # vramSplit writes UMA_SIZE with bc250memcfg only if CMOS differs.
        # This is applied during nixos-rebuild switch and at boot as a safety net.
        # This option writes to the CMOS memory, so setting it back to null will NOT
        # reset back to the BIOS default, you'll need to go back into the BIOS and reset it manually.
        #
        # I recommend setting this value to 6144 (6 GB).
        #
        # NOTE: For some reason, a value of 2048 causes the graphics driver to fail to initialize.
        vramSplit = 6144;

        # Null by default. Value is in MB and converted to 4 KiB pages for ttm.pages_limit.
        # This value determines how much additional memory the OS can dynamically allocate to VRAM.
        # You probably don't need to change this value.
        vramDynamicSplit = null; # example: 4096

        # Rebuilds amdgpu and Mesa on kernel and Mesa updates. The patches
        # target specific versions and may fail to apply after a nixpkgs bump.
        # Make sure to test the unlocked compute units before relying on them.
        gpuPatches = {
          enable = true;
          cuUnlock.enable = true;
        };

        # SMU SRAM patching: fixes 8-core telemetry (requires amdgpu patches
        # via `gpuPatches`). Applied on every boot since it does not survive
        # a cold power cycle. BIOS 3.00 only; 5.00 is not supported; modded
        # BIOSes may already include this.
        smuPatch.enable = true;
      };
    };
    enableRedistributableFirmware = true;
  };
  services.cyan-skillfish-governor-smu.settings.gpu-usage.fix-freq = true;

  jovian = {
    decky-loader.enable = false;

    devices.steamdeck = {
      enable = false;
    };

    hardware = {
      has.amd.gpu = true;
      amd.gpu = {
        enableBacklightControl = false;
      };
    };

    steam = {
      enable = true;
      autoStart = true;
      user = "ops";
      desktopSession = "gamescope-wayland";
    };

    steamos = {
      enableHdmiCecIntegration = false;
      enableZram = false;
    };

    workarounds.ignoreMissingKernelModules = false;
  };

  kp = {
    desktop.enable = false;
    gaming = {
      steam.enable = false; # Jovian supplies Steam
      sunshine = {
        enable = true;
        virtualMonitor = false;
      };
    };
    networking.networkmanager.enable = true;
    tailscale.enable = false;
  };
  services.journald.settings.Journal.Storage = "persistent";
  systemd.services.enp4s0-diagnostics = {
    description = "Capture periodic diagnostics for enp4s0";
    path = [
      pkgs.coreutils
      pkgs.ethtool
      pkgs.gnugrep
      pkgs.iproute2
      pkgs.networkmanager
      pkgs.pciutils
      pkgs.systemd
    ];
    script = ''
      run_check() {
        label="$1"
        shift
        printf '\n--- %s ---\n' "$label"
        if timeout --signal=TERM --kill-after=1s 2s "$@"; then
          :
        else
          status=$?
          printf '[command failed or timed out: status %s]\n' "$status"
        fi
      }

      printf 'snapshot_time='
      date --iso-8601=seconds
      printf 'boot_id='
      cat /proc/sys/kernel/random/boot_id

      run_check 'carrier' cat /sys/class/net/enp4s0/carrier
      run_check 'link statistics' ip -details -statistics link show dev enp4s0
      run_check 'interface addresses' ip -brief address show dev enp4s0
      run_check 'default routes' ip route show default
      run_check 'ethtool link' ethtool enp4s0
      run_check 'ethtool driver' ethtool -i enp4s0
      run_check 'ethtool counters' ethtool -S enp4s0
      run_check 'network manager state' nmcli -f GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,IP4.GATEWAY device show enp4s0
      run_check 'network service state' systemctl show -p ActiveState -p SubState dhcpcd.service NetworkManager.service tailscaled.service
      run_check 'NIC PCI state' lspci -nnk -s 04:00.0
      run_check 'NIC root-port PCI state' lspci -vv -s 00:15.1
      run_check 'recent NIC kernel messages' /bin/sh -c '
        journalctl -k --since "35 seconds ago" --no-pager -o short-precise |
          grep -E "r8169|enp4s0|00:15\\.1|AER|PCIe Bus Error" ||
          echo "(no matching kernel messages in the last 35 seconds)"
      '
    '';
    serviceConfig = {
      Type = "oneshot";
      TimeoutStartSec = "28s";
      StandardOutput = "journal";
      StandardError = "journal";
      SyslogIdentifier = "enp4s0-diagnostics";
      ProtectSystem = "strict";
      ProtectHome = true;
      NoNewPrivileges = true;
    };
  };
  systemd.timers.enp4s0-diagnostics = {
    description = "Run enp4s0 diagnostics every 30 seconds";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "30s";
      OnUnitActiveSec = "30s";
      AccuracySec = "1s";
    };
  };
  systemd.sleep.settings.Sleep.AllowSuspend = false;
  systemd.services.display-manager.serviceConfig.ExecStartPre = lib.mkForce [
    "${pkgs.coreutils}/bin/rm -f /etc/sddm.conf.d/zzt-steamos-temp-login.conf"
    "${pkgs.coreutils}/bin/rm -f /etc/sddm.conf.d/zzt-holo-temp-login.conf"
  ];
}
